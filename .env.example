# .env.example
# This file is a TEMPLATE for your local development environment.
# Copy this file to a new file named '.env' (without '.example') in your project root.
# Fill in your actual API keys in the local .env file *for local testing purposes only*.
# DO NOT COMMIT YOUR .env FILE TO GIT.

# For GitHub Actions, ALL of these values MUST be set as repository secrets
# in your GitHub repository's Settings > Secrets and variables > Actions.

# Google Gemini API Key (Official Python SDK: google-generativeai)
GOOGLE_API_KEY="your_local_gemini_api_key_here"

# EventRegistry API Key
EVENT_REGISTRY_API_KEY="your_local_eventregistry_api_key_here"

# Gemini Model to use (e.g., 'gemini-pro' or 'gemini-1.5-pro-latest')
GEMINI_MODEL="gemini-pro"

# Twitter API Keys (for Tweepy v2 and v1.1 compatibility)
# Get these from your Twitter Developer App
TWITTER_BEARER_TOKEN="your_local_twitter_bearer_token_v2_here"
TWITTER_API_KEY="your_local_twitter_api_key_here"
TWITTER_API_SECRET="your_local_twitter_api_secret_here"
TWITTER_ACCESS_TOKEN="your_local_twitter_access_token_here"
TWITTER_ACCESS_SECRET="your_local_twitter_access_secret_here"
# Twitter Username (for constructing tweet permalinks, e.g., "SHA256News")
TWITTER_USERNAME="SHA256News"

# GitHub Personal Access Token (for creating issues and pushing to gh-pages)
# This PAT MUST have 'repo' scope.
GH_PAT="your_local_github_personal_access_token_here"

# Image Library Activation Flag:
# Set to 'True' (string) to enable image attachment to tweets.
# Set to 'False' (string) or omit to disable images (no images will be attached, no errors).
IMAGE_LIBRARY_ACTIVE="False"

# (Optional) For future automated grounding search using an external API
# These would also be GitHub secrets if used in actions.
# GOOGLE_CUSTOM_SEARCH_API_KEY="your_local_google_custom_search_api_key"
# GOOGLE_CUSTOM_SEARCH_CX="your_local_custom_search_engine_id"

# (Optional) For future proactive alerting (e.g., SendGrid)
# These would also be GitHub secrets if used in actions.
# ALERT_EMAIL_RECIPIENT="your_email@example.com"
# SENDGRID_API_KEY="your_local_sendgrid_api_key"
